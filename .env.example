# 复制为 .env 使用（.env 已被 gitignore，不入库）

# === 数据库（PostgreSQL）===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=confmanage

# === Flask ===
# 生产环境务必替换为随机长字符串
SECRET_KEY=dev-secret-key-change-in-production

# === 服务监听 ===
HOST_BIND=0.0.0.0
HOST_PORT=5001
HOST_DEBUG=true

# === CORS ===
# 逗号分隔的前端来源白名单；留空使用默认（5173-5177/3000）
CORS_ORIGINS=

# === AI 接口 ===
# 默认 true（兼容本地大模型与 Fake-IP 代理环境）；
# 加固部署设为 false，禁止后端请求私网/环回地址
ALLOW_PRIVATE_API_TARGETS=true
